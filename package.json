{
  "name": "modello-tests-fixer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent that repairs Modello model configuration when generated Cypress tests fail",
  "bin": {
    "modello-fixer": "dist/cli.js",
    "modello-orchestrate": "dist/orchestrate.js",
    "modello-fix-course": "dist/fix-course.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p ui",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "orchestrate": "tsx src/orchestrate.ts",
    "ui:dev": "vite ui",
    "ui:build": "vite build ui",
    "fix-course": "tsx src/fix-course.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
